# Copy to .env. Never commit credentials.
# Run the first demo with: python -m luna --demo
LUNA_TOKEN=replace-with-a-long-random-token
HERMES_BASE_URL=http://127.0.0.1:8642
HERMES_API_KEY=
OPENAI_API_KEY=
LUNA_VOICE_MODEL=gpt-live-1
LUNA_ROUTER_MODEL=gpt-5.6-luna
LUNA_DATABASE=.state/luna.sqlite
# Bind to loopback by default. Use an HTTPS reverse proxy for remote access.
LUNA_HOST=127.0.0.1
LUNA_PORT=8787
